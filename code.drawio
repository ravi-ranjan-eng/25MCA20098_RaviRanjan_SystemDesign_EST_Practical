flowchart TD

    C["Customer<br/>Web / Mobile App<br/>Browse Restaurants<br/>Place Order<br/>Track Delivery"]

    LB["Load Balancer<br/>Distributes Traffic"]

    AS["Application Server"]

    subgraph SERVICES["Core Services"]
        RS["Restaurant Service"]
        OS["Order Service"]
        PS["Payment Service"]
        DS["Delivery Service"]
        NS["Notification Service"]
    end

    DB[("Database<br/>PostgreSQL / MySQL<br/>Users, Restaurants,<br/>Orders, Payments")]

    PG["Payment Gateway<br/>Razorpay / Stripe"]

    R["Restaurant<br/>Receives Order"]

    DP["Delivery Partner<br/>Picks Up & Delivers"]

    N["Customer Notification<br/>Order Status Updates"]

    C -->|"Browse / Order / Track Request"| LB
    LB --> AS

    AS --> RS
    AS --> OS
    AS --> PS
    AS --> DS
    AS --> NS

    RS <-->|"Restaurant Data"| DB
    OS <-->|"Save / Retrieve Orders"| DB
    PS <-->|"Payment Records"| DB
    DS <-->|"Delivery Details"| DB

    RS -->|"Display Restaurants & Menu"| C

    OS -->|"Payment Request"| PS
    PS <-->|"Process Payment"| PG
    PS -->|"Payment Confirmation"| OS

    OS -->|"Send Order"| R
    R -->|"Accept / Reject Order"| OS

    OS -->|"Assign Delivery"| DS
    DS -->|"Delivery Request"| DP
    DP -->|"Delivery Status"| DS

    OS -->|"Order Updates"| NS
    DS -->|"Delivery Updates"| NS
    NS -->|"Real-time Notifications"| C

    style C fill:#dbeafe,stroke:#2563eb,color:#000
    style LB fill:#ede9fe,stroke:#7c3aed,color:#000
    style AS fill:#dcfce7,stroke:#16a34a,color:#000
    style DB fill:#ffedd5,stroke:#ea580c,color:#000
    style PG fill:#fce7f3,stroke:#db2777,color:#000
    style N fill:#d1fae5,stroke:#059669,color:#000
